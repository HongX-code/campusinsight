# 复制为 terraform.tfvars 后填写；该文件已被 .gitignore 忽略，禁止提交
region           = "cn-north-4"
project_name     = "gaoxiao-zhixun"
vpc_cidr         = "192.168.0.0/16"
subnet_cidr      = "192.168.1.0/24"
az_primary       = "cn-north-4a"
az_secondary     = "cn-north-4b"

# 比赛演示推荐：主备 2C4G + 40GB SSD；预算敏感可改 false + 单机规格
rds_ha           = true
rds_flavor       = "rds.mysql.n1.large.2.ha"
rds_volume_size  = 40
rds_password     = "CHANGE_ME_Rds_2026!"

# 1GB 主备 Redis；若规格在目标 Region 不可用，请先查控制台规格再改
dcs_capacity     = 1
dcs_flavor       = "redis.ha.xu1.large.r2.1"
redis_password   = "CHANGE_ME_Redis_2026!"

# 安全组来源：SSH 建议收敛到学校/公司出口 IP；Web 演示可先全开，正式环境收紧
allowed_ssh_cidr = "0.0.0.0/0"
allowed_web_cidr = "0.0.0.0/0"