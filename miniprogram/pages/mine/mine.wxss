/* 我的页 */

/* ---------------------------------------------------------------- 身份 */
.profile-card {
  display: flex;
  align-items: center;
  background: var(--surface);
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}

.avatar {
  flex: none;
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 40rpx;
  font-weight: 600;
  margin-right: 24rpx;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 600;
}

.profile-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.profile-empty {
  color: var(--text-tertiary);
}

.edit-btn {
  flex: none;
  font-size: 25rpx;
  color: var(--primary);
  padding: 10rpx 24rpx;
  border: 2rpx solid var(--primary-light);
  border-radius: 999rpx;
}

/* ---------------------------------------------------------------- 表单 */
.block-title {
  font-size: 30rpx;
  font-weight: 600;
}

.form-hint {
  font-size: 23rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}

.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.form-btn {
  flex: 1;
  height: 84rpx;
}

/* ---------------------------------------------------------------- 统计 */
.todo-stat {
  display: flex;
  background: var(--surface);
  border-radius: 24rpx;
  padding: 26rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}

.todo-cell {
  flex: 1;
  text-align: center;
  position: relative;
}

.todo-cell + .todo-cell::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10rpx;
  bottom: 10rpx;
  width: 2rpx;
  background: var(--border-light);
}

.todo-num {
  font-size: 40rpx;
  font-weight: 600;
}

.todo-doing {
  color: var(--accent);
}

.todo-done {
  color: var(--success);
}

.todo-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

/* ---------------------------------------------------------------- 待办 */
.section-head {
  padding: 8rpx 8rpx 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
}

.task-card {
  padding: 24rpx 28rpx;
}

.task-done {
  opacity: 0.72;
}

.task-title {
  font-size: 28rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.task-title-done {
  text-decoration: line-through;
  color: var(--text-secondary);
}

.task-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.task-deadline {
  font-size: 23rpx;
  color: var(--text-secondary);
}

.task-ops {
  flex: none;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-left: 20rpx;
}

.op-btn {
  font-size: 23rpx;
  color: var(--primary);
  padding: 8rpx 20rpx;
  border: 2rpx solid var(--primary-light);
  border-radius: 12rpx;
  text-align: center;
  white-space: nowrap;
}

.op-del {
  color: var(--text-secondary);
  border-color: var(--border);
}

/* ---------------------------------------------------------------- 设置 */
.setting-card {
  padding: 26rpx 28rpx;
}

.setting-name {
  font-size: 28rpx;
  font-weight: 500;
}

.setting-desc {
  font-size: 23rpx;
  color: var(--text-tertiary);
  margin-top: 6rpx;
  line-height: 1.55;
}

.link-btn {
  flex: none;
  font-size: 25rpx;
  color: var(--primary);
  margin-left: 20rpx;
}

.chevron {
  color: var(--text-tertiary);
  font-size: 34rpx;
}

.foot-note {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-tertiary);
  padding: 20rpx 40rpx 40rpx;
  line-height: 1.6;
}

.empty-mini {
  background: var(--surface);
  border-radius: 24rpx;
  padding: 56rpx 32rpx;
  margin-bottom: 24rpx;
  text-align: center;
  font-size: 25rpx;
  color: var(--text-tertiary);
  line-height: 1.65;
}

.go-btn {
  margin-top: 28rpx;
  height: 76rpx;
  width: 320rpx;
  margin-left: auto;
  margin-right: auto;
  font-size: 26rpx;
}

.retry-btn {
  margin-top: 24rpx;
  width: 300rpx;
  margin-left: auto;
  margin-right: auto;
}
