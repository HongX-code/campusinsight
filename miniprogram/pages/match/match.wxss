/* 匹配页：三级结论的视觉区分靠左侧色条，不靠大面积底色 */

.profile-tip {
  background: var(--primary-soft);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.profile-tip-title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--primary);
}

.profile-tip-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

/* ---------------------------------------------------------------- 筛选 */
.level-tabs {
  display: flex;
  background: var(--surface);
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}

.level-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 4rpx;
  font-size: 25rpx;
  color: var(--text-secondary);
  border-radius: 14rpx;
}

.level-tab-on {
  background: var(--primary);
  color: #FFFFFF;
  font-weight: 500;
}

.level-num {
  font-size: 22rpx;
  opacity: 0.85;
}

.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 22rpx;
}

.switch-item {
  display: flex;
  align-items: center;
}

.switch-box {
  width: 76rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: #E5E7EB;
  padding: 4rpx;
  transition: background 160ms ease;
}

.switch-on {
  background: var(--primary);
}

.switch-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #FFFFFF;
  transition: transform 160ms ease;
}

.switch-on .switch-dot {
  transform: translateX(32rpx);
}

.switch-label {
  margin-left: 14rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.filter-hint {
  font-size: 21rpx;
  color: var(--text-tertiary);
  max-width: 50%;
  text-align: right;
  line-height: 1.5;
}

/* ---------------------------------------------------------------- 卡片 */
.level-card {
  border-left: 8rpx solid var(--border);
}

.level-match {
  border-left-color: var(--success);
}

.level-maybe {
  border-left-color: var(--warning);
}

.level-no {
  border-left-color: #D1D5DB;
  opacity: 0.92;
}

.badge {
  flex: none;
  margin-left: 16rpx;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}

.badge-match {
  background: var(--success-soft);
  color: var(--success);
}

.badge-maybe {
  background: var(--warning-soft);
  color: var(--warning);
}

.badge-no {
  background: #F3F4F6;
  color: var(--text-secondary);
}

.meta-row {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.reasons {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--border-light);
}

.reason-line {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.reason-dot {
  color: var(--primary-light);
  margin-right: 8rpx;
}

.retry-btn {
  margin-top: 24rpx;
  width: 300rpx;
  margin-left: auto;
  margin-right: auto;
}
