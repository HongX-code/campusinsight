/* 高校智讯 · 小程序全局样式
   与 Web 端 Arctic Glass 设计系统同源：同一套色板、同一套圆角与留白。
   小程序不支持 CSS 变量在部分基础库下的继承，这里仍用 :root 变量并在
   每个页面里以 var() 引用——基础库 2.9 以上均支持。 */

page {
  --primary: #2563EB;
  --primary-soft: #EFF6FF;
  --primary-light: #DBEAFE;
  --accent: #7C3AED;
  --accent-soft: #F5F3FF;
  --success: #16A34A;
  --success-soft: #F0FDF4;
  --warning: #D97706;
  --warning-soft: #FFFBEB;
  --danger: #DC2626;
  --danger-soft: #FEF2F2;
  --bg: #F6F8FC;
  --surface: #FFFFFF;
  --border: #E5E7EB;
  --border-light: #EEF2F7;
  --text-primary: #111827;
  --text-secondary: #6B7280;
  --text-tertiary: #9CA3AF;

  background: var(--bg);
  color: var(--text-primary);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 24rpx 28rpx 40rpx;
}

/* ------------------------------------------------------------------ 卡片 */
.card {
  background: var(--surface);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}

.card-tap {
  transition: transform 120ms ease;
}

.card-tap:active {
  transform: scale(0.985);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.45;
}

.card-meta {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.grow {
  flex: 1;
  min-width: 0;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ------------------------------------------------------------------ 标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
  line-height: 1.6;
}

.tag-gray {
  background: #F3F4F6;
  color: var(--text-secondary);
}

.tag-warn {
  background: var(--warning-soft);
  color: var(--warning);
}

.tag-danger {
  background: var(--danger-soft);
  color: var(--danger);
}

.tag-success {
  background: var(--success-soft);
  color: var(--success);
}

.tag-accent {
  background: var(--accent-soft);
  color: var(--accent);
}

/* ------------------------------------------------------------------ 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-primary {
  background: var(--primary);
  color: #FFFFFF;
}

.btn-ghost {
  background: var(--surface);
  color: var(--primary);
  border: 2rpx solid var(--primary-light);
}

.btn:active {
  opacity: 0.85;
}

/* ------------------------------------------------------------------ 状态 */
.empty {
  text-align: center;
  padding: 100rpx 40rpx;
  color: var(--text-tertiary);
  font-size: 26rpx;
}

.loading {
  text-align: center;
  padding: 60rpx;
  color: var(--text-tertiary);
  font-size: 26rpx;
}

.divider {
  height: 2rpx;
  background: var(--border-light);
  margin: 20rpx 0;
}

/* ------------------------------------------------------------------ 表单 */
.field {
  margin-bottom: 24rpx;
}

.field-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
}

.field-input {
  height: 80rpx;
  background: #F8FAFC;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

/* 顶部胶囊占位：自定义导航栏时给内容让出空间 */
.safe-top {
  padding-top: 12rpx;
}
