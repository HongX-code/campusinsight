# ===== 数据库 =====
# 本地开发默认使用 SQLite（无需配置）
# 华为云 RDS for MySQL 示例：
# DATABASE_URL=mysql+pymysql://root:YourPassword@192.168.0.10:3306/gaoxiao_zhixun?charset=utf8mb4
DATABASE_URL=

# ===== 大模型服务 =====
# provider 可选：maas（华为云 ModelArts Studio / MaaS，OpenAI 兼容接口）、deepseek、openai、none
# 留空或 none 时系统自动降级为本地规则引擎，并在界面上明确标注来源
LLM_PROVIDER=maas
LLM_BASE_URL=https://api.modelarts-maas.com/v1
LLM_API_KEY=
LLM_MODEL=DeepSeek-V3
LLM_TIMEOUT=45

# ===== 缓存（可选，华为云 DCS for Redis）=====
# 未配置时自动降级为进程内缓存，不影响功能
REDIS_URL=

# ===== 应用 =====
# 本地开发请保持 127.0.0.1：0.0.0.0 是"监听所有网卡"的通配地址，
# 不是浏览器网址；复制 http://0.0.0.0:8000 到浏览器会显示「无法访问此页面」。
# 只有部署到 ECS / 容器、需要被外部访问时才改成 0.0.0.0，
# 届时浏览器访问的是服务器公网 IP 或域名，仍然不是 0.0.0.0。
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false

# ===== 采集白名单（逗号分隔，留空表示仅允许 .edu.cn 域名）=====
CRAWL_ALLOWED_DOMAINS=whut.edu.cn,edu.cn,ac.cn

# ===== 微信小程序（可选）=====
# 全部留空时进入「游客演示模式」：用 device_key 派生稳定账号 mock_xxxx，
# 小程序仍可完整跑通登录、匹配、待办、清单、日历订阅，只是不能发订阅消息。
# 填入 AppID/Secret 后自动切到真实 jscode2session 登录。
WECHAT_APPID=
WECHAT_SECRET=

# 订阅消息模板 ID（在微信公众平台「订阅消息」里申请「截止日期提醒」模板）。
# 留空时 /api/wechat/subscribe 返回 code=no_template 并降级为站内提醒，
# 不会报错，也不影响其它端。模板字段约定：thing1=通知标题 / time2=截止日期
# / thing3=分类 / thing4=剩余天数。
WECHAT_TEMPLATE_DEADLINE=

# 小程序版本：developer（开发版）/ trial（体验版）/ formal（正式版）。
# 必须与小程序实际提交的版本一致，否则微信侧下发失败（errcode 40165）。
WECHAT_MP_STATE=developer

# 登录票据有效期（天）。票据是本地自签的，不依赖微信 session_key
# （后者 2 小时过期，会造成莫名其妙掉登录）。
WECHAT_TOKEN_TTL_DAYS=30

# 全局推送开关，false 时不发任何订阅消息（排查线上问题时用）
WECHAT_PUSH_ENABLED=true

# 日历订阅里事件 UID 的域名后缀。UID 稳定才能保证重复订阅不产生重复条目，
# 展示用途，随意填一个自有域名即可。
CALENDAR_UID_DOMAIN=campusinsight.local
