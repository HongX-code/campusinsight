# ===== 数据库 =====
# 本地开发默认使用 SQLite（无需配置）
# 华为云 RDS for MySQL 示例：
# DATABASE_URL=mysql+pymysql://root:YourPassword@192.168.0.10:3306/gaoxiao_zhixun?charset=utf8mb4
DATABASE_URL=

# ===== 大模型服务 =====
# provider 可选：maas（华为云 ModelArts Studio / MaaS，OpenAI 兼容接口）、deepseek、openai、none
# 留空或 none 时系统自动降级为本地规则引擎，并在界面上明确标注来源
LLM_PROVIDER=maas
LLM_BASE_URL=https://api.modelarts-maas.com/v1
LLM_API_KEY=
LLM_MODEL=DeepSeek-V3
LLM_TIMEOUT=45

# ===== 缓存（可选，华为云 DCS for Redis）=====
# 未配置时自动降级为进程内缓存，不影响功能
REDIS_URL=

# ===== 应用 =====
# 本地开发请保持 127.0.0.1：0.0.0.0 是"监听所有网卡"的通配地址，
# 不是浏览器网址；复制 http://0.0.0.0:8000 到浏览器会显示「无法访问此页面」。
# 只有部署到 ECS / 容器、需要被外部访问时才改成 0.0.0.0，
# 届时浏览器访问的是服务器公网 IP 或域名，仍然不是 0.0.0.0。
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false

# ===== 采集白名单（逗号分隔，留空表示仅允许 .edu.cn 域名）=====
CRAWL_ALLOWED_DOMAINS=whut.edu.cn,edu.cn,ac.cn
